generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * AUTH (Auth.js / NextAuth) tables
 * + Our custom app models (role, auditions, events, etc.)
 */

enum Role {
  USER
  ADMIN
}

enum AuditionCategory {
  SINGER
  INSTRUMENTALIST
  PRODUCTION
}

enum VoicePart {
  SOPRANO
  ALTO
  TENOR
  BASS
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  ACCEPTED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum MusicSheetAudience {
  ALL_USERS
  CHORISTERS_ONLY
}

enum EventResponseStatus {
  ATTENDING
  MAYBE
  NOT_ATTENDING
}

enum NotificationAudience {
  ADMIN
  CHORISTERS
  PUBLIC
}

enum NotificationType {
  CHORISTER_NOTICE
  ATTENDANCE_MARKED
  REHEARSAL_CREATED
  PUBLIC_ANNOUNCEMENT
  PUBLIC_EVENT
  SYSTEM
}

enum AcademyArticleStatus {
  DRAFT
  PUBLISHED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // For Credentials login (email/password)
  passwordHash String?

  role               Role    @default(USER)
  isChorister        Boolean @default(false)
  choristerVerified  Boolean @default(false)
  adminNote          String?
  onboardingComplete Boolean @default(false)

  accounts               Account[]
  sessions               Session[]
  auditions              AuditionApplication[]
  choristerProfile       ChoristerProfile?
  choristerAttendances   AttendanceRecord[]
  notificationReads      NotificationRead[]
  academyArticles        AcademyArticle[]
  quizAttempts           QuizAttempt[]
  dailyChallengeAttempts DailyChallengeAttempt[]
  leaderboardEntries     LeaderboardEntry[]
  achievements           UserAchievement[]
  featuredSpotlights     ChoristerSpotlight[]    @relation("SpotlightFeaturedUser")
  challengeSubmissions   ChallengeSubmission[]
  challengeVotes         ChallengeVote[]
  sightReadingAttempts   SightReadingAttempt[]
  profile                UserProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordReset {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

/**
 * AUDITIONS
 */
model AuditionApplication {
  id     String  @id @default(cuid())
  userId String?

  fullName String
  phone    String
  email    String
  city     String?
  category AuditionCategory

  // For SINGERS
  voicePart         VoicePart?
  singingExperience String?
  auditionSong      String?

  // For INSTRUMENTALISTS
  instrument      String?
  instrumentLevel String? // beginner/intermediate/advanced
  canSightRead    Boolean?

  // For PRODUCTION
  productionRole String? // producer, content, media, graphics, etc.
  portfolioLink  String?

  notes  String?
  status ApplicationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([userId])
  @@index([status])
  @@index([category])
}

model AuditionSetting {
  id               String    @id @default("current")
  startsAt         DateTime?
  venue            String?
  note             String?
  anticipationText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * OPTIONAL: EVENTS + ANNOUNCEMENTS (nice for the website)
 */
model Event {
  id            String          @id @default(cuid())
  title         String
  description   String?
  location      String?
  imageUrl      String?
  imagePublicId String?
  videoUrl      String?
  videoPublicId String?
  startsAt      DateTime
  endsAt        DateTime?
  isPublished   Boolean         @default(false)
  responses     EventResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventResponse {
  id        String              @id @default(cuid())
  eventId   String
  status    EventResponseStatus
  fullName  String
  email     String
  phone     String
  note      String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([eventId])
  @@index([email])
}

model Announcement {
  id          String  @id @default(cuid())
  title       String
  body        String
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String?
  imageUrl  String
  publicId  String   @unique
  createdAt DateTime @default(now())
}

model MusicItem {
  id        String   @id @default(cuid())
  title     String?
  audioUrl  String
  publicId  String   @unique
  createdAt DateTime @default(now())
}

model MusicSheet {
  id             String             @id @default(cuid())
  title          String?
  slug           String             @unique
  composer       String             @default("Sir Jude Nnam")
  description    String?
  voicing        String?
  lyricsLanguage String?
  scoreKey       String?
  fileName       String
  fileUrl        String
  mimeType       String?
  publicId       String             @unique
  audience       MusicSheetAudience @default(ALL_USERS)
  isPublished    Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model VideoItem {
  id        String   @id @default(cuid())
  title     String?
  videoUrl  String
  posterUrl String?
  publicId  String   @unique
  createdAt DateTime @default(now())
}

model ChoristerProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  phone            String?
  address          String?
  voicePart        String?
  dateOfBirth      DateTime?
  gender           String?
  maritalStatus    String?
  emergencyContact String?
  stateOfOrigin    String?
  currentParish    String?
  socialHandle     String?
  passportImageUrl String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  phone         String?
  address       String?
  stateOfOrigin String?
  currentParish String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChoristerNotice {
  id            String   @id @default(cuid())
  title         String
  body          String
  attachmentUrl String?
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Rehearsal {
  id        String   @id @default(cuid())
  title     String
  startsAt  DateTime
  createdAt DateTime @default(now())

  attendance AttendanceRecord[]
}

model AttendanceRecord {
  id          String           @id @default(cuid())
  rehearsalId String
  userId      String
  status      AttendanceStatus @default(PRESENT)
  excuseNote  String?
  autoMarked  Boolean          @default(false)
  markedAt    DateTime         @default(now())
  confirmedAt DateTime?
  confirmedBy String?

  rehearsal Rehearsal @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rehearsalId, userId])
  @@index([userId])
  @@index([rehearsalId])
}

model Notification {
  id        String               @id @default(cuid())
  audience  NotificationAudience
  type      NotificationType     @default(SYSTEM)
  sourceId  String?
  title     String
  body      String
  href      String?
  actorId   String?
  metadata  Json?
  reads     NotificationRead[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([type, sourceId, audience])
  @@index([audience, createdAt])
  @@index([type, sourceId])
}

model NotificationRead {
  id             String   @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
}

model AcademyCategory {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  description String?
  articles    AcademyArticle[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model AcademyArticle {
  id                 String               @id @default(cuid())
  title              String
  slug               String               @unique
  excerpt            String?
  body               String
  coverImageUrl      String?
  coverImagePublicId String?
  tags               String[]             @default([])
  status             AcademyArticleStatus @default(DRAFT)
  isFeatured         Boolean              @default(false)
  isTrending         Boolean              @default(false)
  views              Int                  @default(0)
  categoryId         String
  authorId           String?
  publishedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  category AcademyCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author   User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([authorId])
  @@index([status, publishedAt])
  @@index([isFeatured])
  @@index([isTrending])
}

model Quiz {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?
  category    String
  isPublished Boolean       @default(false)
  isPopular   Boolean       @default(false)
  questions   Question[]
  attempts    QuizAttempt[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([category])
  @@index([isPublished, createdAt])
  @@index([isPopular])
}

model Question {
  id           String   @id @default(cuid())
  quizId       String
  prompt       String
  options      Json
  correctIndex Int
  explanation  String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, order])
}

model QuizAttempt {
  id                    String   @id @default(cuid())
  quizId                String
  userId                String?
  score                 Int
  totalQuestions        Int
  completionTimeSeconds Int
  answers               Json
  createdAt             DateTime @default(now())

  quiz Quiz  @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([quizId])
  @@index([userId])
}

model DailyChallenge {
  id                   String                  @id @default(cuid())
  challengeDate        DateTime                @unique
  title                String
  prompt               String
  options              Json
  correctIndex         Int
  explanation          String?
  soundConfig          Json?
  sightReadingExercise Json?
  isPublished          Boolean                 @default(true)
  attempts             DailyChallengeAttempt[]
  sightReadingAttempts SightReadingAttempt[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([isPublished, challengeDate])
}

model DailyChallengeAttempt {
  id                    String   @id @default(cuid())
  challengeId           String
  userId                String?
  selectedIndex         Int
  isCorrect             Boolean
  completionTimeSeconds Int?
  createdAt             DateTime @default(now())

  challenge DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([challengeId, userId])
  @@index([challengeId])
  @@index([userId])
}

model LeaderboardEntry {
  id                     String   @id @default(cuid())
  userId                 String
  period                 String
  periodKey              String
  points                 Int      @default(0)
  quizPoints             Int      @default(0)
  dailyChallengePoints   Int      @default(0)
  participationPoints    Int      @default(0)
  quizAttempts           Int      @default(0)
  dailyChallengeAttempts Int      @default(0)
  rank                   Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, periodKey])
  @@index([period, periodKey, rank])
  @@index([userId])
}

model Achievement {
  id          String            @id @default(cuid())
  code        String            @unique
  title       String
  description String
  icon        String
  accent      String?
  isActive    Boolean           @default(true)
  users       UserAchievement[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  awardedAt     DateTime @default(now())
  source        String?
  metadata      Json?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, awardedAt])
}

model ChoristerSpotlight {
  id             String   @id @default(cuid())
  featuredUserId String?
  name           String
  photoUrl       String?
  photoPublicId  String?
  story          String
  musicalJourney String
  favoriteSong   String?
  advice         String?
  weekStart      DateTime
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  featuredUser User? @relation("SpotlightFeaturedUser", fields: [featuredUserId], references: [id], onDelete: SetNull)

  @@index([isPublished, weekStart])
  @@index([featuredUserId])
}

model Challenge {
  id                   String                @id @default(cuid())
  title                String
  slug                 String                @unique
  type                 String
  description          String?
  prompt               String?
  rules                String?
  coverImageUrl        String?
  coverImagePublicId   String?
  sightReadingExercise Json?
  startsAt             DateTime?
  endsAt               DateTime?
  isPublished          Boolean               @default(false)
  submissions          ChallengeSubmission[]
  votes                ChallengeVote[]
  sightReadingAttempts SightReadingAttempt[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([isPublished, startsAt, endsAt])
  @@index([type])
  @@index([createdAt])
}

model ChallengeSubmission {
  id            String   @id @default(cuid())
  challengeId   String
  userId        String?
  title         String?
  description   String
  mediaType     String   @default("TEXT")
  audioUrl      String?
  videoUrl      String?
  mediaPublicId String?
  status        String   @default("PENDING")
  adminNote     String?
  isWinner      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  challenge Challenge       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  votes     ChallengeVote[]

  @@index([challengeId, status])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([isWinner])
}

model ChallengeVote {
  id           String   @id @default(cuid())
  challengeId  String
  submissionId String
  userId       String
  createdAt    DateTime @default(now())

  challenge  Challenge           @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  submission ChallengeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@unique([submissionId, userId])
  @@index([challengeId, createdAt])
  @@index([submissionId])
  @@index([userId])
}

model SightReadingAttempt {
  id                     String   @id @default(cuid())
  userId                 String?
  dailyChallengeId       String?
  challengeId            String?
  sourceType             String
  exerciseTitle          String
  score                  Int
  pitchScore             Int
  rhythmScore            Int
  stabilityScore         Int
  transpositionSemitones Float?
  metrics                Json?
  feedback               Json?
  createdAt              DateTime @default(now())

  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  dailyChallenge DailyChallenge? @relation(fields: [dailyChallengeId], references: [id], onDelete: Cascade)
  challenge      Challenge?      @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([dailyChallengeId, createdAt])
  @@index([challengeId, createdAt])
  @@index([sourceType, score])
}
